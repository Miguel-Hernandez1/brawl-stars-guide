# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Brawl Stars API key from developer.brawlstars.com
# IMPORTANT: Keys are IP-restricted. Register your current public IP when creating the key.
BRAWLSTARS_API_TOKEN=

# PostgreSQL connection string
# Default matches the docker-compose.yml local dev setup
DATABASE_URL=postgres://playbook:playbook@localhost:5432/playbook?sslmode=disable

# Path to SQL migration files (relative to project root)
# Only change if you move the migrations directory
MIGRATIONS_PATH=db/migrations
